# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=False
# Comma-separated. Production: api.example.com,localhost. Dev: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# In docker-compose dev this is overridden to point at the `db` service.
DATABASE_URL=postgres://yordamchim:yordamchim@localhost:5432/yordamchim

# --- CORS / CSRF -----------------------------------------------------------
# Comma-separated frontend origins (full scheme+host).
CORS_ALLOWED_ORIGINS=http://localhost:3030
# Only needed for Django admin behind HTTPS. DRF (JWT bearer) doesn't use CSRF.
CSRF_TRUSTED_ORIGINS=

# --- Behind a TLS-terminating proxy ---------------------------------------
# Set these when running behind nginx / Traefik / Cloudflare so Django
# trusts X-Forwarded-* and emits HTTPS URLs.
USE_X_FORWARDED_HOST=False
SECURE_PROXY_SSL_HEADER_NAME=
SECURE_PROXY_SSL_HEADER_VALUE=https
SECURE_SSL_REDIRECT=False

# --- JWT lifetimes ---------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=14

# --- DRF throttles --------------------------------------------------------
# Format: "<count>/<period>" where period ∈ {sec,min,hour,day}. Bump in
# dev where you re-take the test repeatedly; tighten in prod.
THROTTLE_AUTH=20/min
THROTTLE_TEST_SUBMIT=30/hour
THROTTLE_SLIDE_URL=120/min

# --- Slide URL signing -----------------------------------------------------
SLIDE_URL_TTL_SECONDS=300
SLIDE_URL_SIGNING_KEY=another-long-random-string

# --- Telegram Mini App -----------------------------------------------------
# Bot token from @BotFather. Empty disables /api/v1/auth/telegram/.
TELEGRAM_BOT_TOKEN=

# --- Storage ---------------------------------------------------------------
# "local" → MEDIA_ROOT on disk. "s3" → S3-compatible bucket via django-storages.
# Works with AWS S3, Cloudflare R2, MinIO, Wasabi, … — switching is just env.
STORAGE_BACKEND=local

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Non-AWS providers: set the API endpoint so boto3 stops talking to AWS.
#   MinIO (docker compose dev) : http://minio:9000
#   Cloudflare R2              : https://<account>.r2.cloudflarestorage.com
#   AWS S3                     : leave empty
AWS_S3_ENDPOINT_URL=
# MinIO needs "path" addressing (bucket in URL path). AWS/R2 use "virtual".
AWS_S3_ADDRESSING_STYLE=path

# --- Gunicorn (prod entrypoint) -------------------------------------------
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- One-shot: seed default subjects/grades/sample test on next boot ------
# Set to `true` for first-time deploys, then back to `false`.
SEED_ON_BOOT=false
